<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯: 오늘의 임무 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:id="@+id/wq_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_icon" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/widget_quests_title"
            android:textColor="#ece9f5"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wq_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#a39dba"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ProgressBar
            android:id="@+id/wq_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="1"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_ok" />
        <TextView
            android:id="@+id/wq_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#6fdc8c"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/wq_pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textColor="#ffd447"
        android:textSize="11sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/wq_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <ImageView
            android:id="@+id/wq_chk0"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_check"
            android:src="@drawable/wchk_off" />
        <TextView
            android:id="@+id/wq_title0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#ece9f5"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/wq_time0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#a39dba"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/wq_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <ImageView
            android:id="@+id/wq_chk1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_check"
            android:src="@drawable/wchk_off" />
        <TextView
            android:id="@+id/wq_title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#ece9f5"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/wq_time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#a39dba"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/wq_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <ImageView
            android:id="@+id/wq_chk2"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_check"
            android:src="@drawable/wchk_off" />
        <TextView
            android:id="@+id/wq_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#ece9f5"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/wq_time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#a39dba"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/wq_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">
        <ImageView
            android:id="@+id/wq_chk3"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_check"
            android:src="@drawable/wchk_off" />
        <TextView
            android:id="@+id/wq_title3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#ece9f5"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/wq_time3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#a39dba"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/wq_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textColor="#a39dba"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
