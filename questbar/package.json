{
  "name": "questbar",
  "productName": "QuestBar",
  "version": "0.1.0",
  "description": "일정·일일임무를 RPG처럼 — 작업표시줄 위에서 싸우는 도트 용사 캘린더 위젯",
  "type": "module",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/**/*.test.js\"",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:dir": "electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  }
}
